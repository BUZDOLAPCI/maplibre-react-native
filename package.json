{
  "name": "monorepo",
  "description": "React Native library for creating maps with MapLibre Native for Android & iOS",
  "version": "11.3.4",
  "private": true,
  "author": "MapLibre",
  "license": "MIT",
  "homepage": "https://github.com/maplibre/maplibre-react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplibre/maplibre-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/maplibre/maplibre-react-native/issues"
  },
  "workspaces": [
    "docs",
    "examples/*",
    "package",
    "scripts"
  ],
  "main": "./package/lib/commonjs/index.js",
  "module": "./package/lib/module/index.js",
  "source": "package/src/index.ts",
  "types": "./package/lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "source": "./package/src/index.ts",
        "types": "./package/lib/typescript/module/index.d.ts",
        "default": "./package/lib/module/index.js"
      },
      "require": {
        "source": "./package/src/index.ts",
        "types": "./package/lib/typescript/commonjs/index.d.ts",
        "default": "./package/lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./app.plugin.js": {
      "require": {
        "default": "./package/app.plugin.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./package/lib/typescript/module/plugin/withMapLibre.d.ts",
        "default": "./package/lib/module/plugin/withMapLibre.js"
      },
      "require": {
        "types": "./package/lib/typescript/commonjs/plugin/withMapLibre.d.ts",
        "default": "./package/lib/commonjs/plugin/withMapLibre.js"
      }
    }
  },
  "scripts": {
    "codegen": "yarn scripts codegen",
    "format": "yarn format:prettier && yarn package format:clang-format && yarn package format:ktlint",
    "format:prettier": "prettier --write '**/*.{ts,tsx,js,json,md,css,yml,yaml}'",
    "lint": "yarn all-workspaces lint",
    "lint:tsc": "yarn all-workspaces lint:tsc",
    "lint:eslint": "yarn all-workspaces lint:eslint",
    "lint:eslint:fix": "yarn all-workspaces lint:eslint:fix",
    "test": "yarn package test",
    "docs": "yarn workspace docs",
    "all-workspaces": "yarn workspaces foreach --all --exclude monorepo --parallel --interlaced run",
    "examples:shared": "yarn workspace @maplibre-react-native/examples",
    "examples:react-native": "yarn workspace react-native-app",
    "examples:expo": "yarn workspace expo-app",
    "package": "yarn workspace @maplibre/maplibre-react-native",
    "scripts": "yarn workspace scripts"
  },
  "packageManager": "yarn@4.10.3",
  "codegenConfig": {
    "name": "MapLibreReactNativeSpec",
    "type": "all",
    "jsSrcsDir": "package/src",
    "android": {
      "javaPackageName": "org.maplibre.reactnative"
    },
    "ios": {
      "componentProvider": {
        "MLRNCallout": "MLRNCalloutComponentView",
        "MLRNCamera": "MLRNCameraComponentView",
        "MLRNImages": "MLRNImagesComponentView",
        "MLRNImageSource": "MLRNImageSourceComponentView",
        "MLRNLayer": "MLRNLayerComponentView",
        "MLRNMapView": "MLRNMapViewComponentView",
        "MLRNNativeUserLocation": "MLRNNativeUserLocationComponentView",
        "MLRNPointAnnotation": "MLRNPointAnnotationComponentView",
        "MLRNRasterSource": "MLRNRasterSourceComponentView",
        "MLRNRasterDEMSource": "MLRNRasterDEMSourceComponentView",
        "MLRNGeoJSONSource": "MLRNGeoJSONSourceComponentView",
        "MLRNVectorSource": "MLRNVectorSourceComponentView"
      }
    }
  },
  "peerDependencies": {
    "@types/geojson": "^7946.0.0",
    "@types/react": ">=19.1.0",
    "expo": ">=54.0.0",
    "react": ">=19.1.0",
    "react-native": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "@types/geojson": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "expo": {
      "optional": true
    }
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "24.8.5",
    "@turf/distance": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/nearest-point-on-line": "^7.3.5"
  },
  "devDependencies": {
    "@castlabs/prettier-tsdoc-plugin": "0.5.8",
    "prettier": "3.8.3"
  }
}
